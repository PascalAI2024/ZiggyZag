{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZiggyZag",
  "version": "0.1.0",
  "identifier": "dev.pascalai.ziggyzag",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZiggyZag",
        "width": 1120,
        "height": 740,
        "minWidth": 720,
        "minHeight": 460
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}

