# Zig build artifacts
zig-cache/
.zig-cache/
zig-out/
dist/

# Compiled binary output
bin/

# Root-level build binaries (correct location is zig-out/bin/, not the repo root)
/ziggyzag
/ziggyzag-desktop
/ziggyzag-agentd
/ziggyzag-launcher
/vt-conformance

# Ignore any .o or .h files generated during build
*.o
*.h

# Ignore OS and editor specific files
**/.DS_Store
*.swp
*~

# Local AI / agent tooling state - none of this should ever be committed.
.opencode/
.worktrees/
.mavis/
.trash/
.pi-subagents/

# IDE and editor metadata
.idea/
.vscode/
*.code-workspace
